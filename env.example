# === REQUIRED DATA ===
# Primary popular-runner discovery (Axiom-style via Mobula Pulse HTTP)
MOBULA_API_KEY=
MOBULA_PULSE_URL=https://api.mobula.io/api/2/pulse
MOBULA_TRENDING_INTERVAL_MS=15000
MOBULA_TRENDING_LIMIT=30
# Reserve only part of the 20-candidate pool for Axiom-style runners so early launches still get watched.
MOBULA_ACTIVE_SLOTS=12
MOBULA_MIN_VOLUME_1H_USD=5000
MOBULA_MIN_LIQUIDITY_USD=1500
MOBULA_MIN_PRICE_CHANGE_1H_PCT=5
MOBULA_TIMEOUT_MS=8000

BIRDEYE_API_KEY=
JUPITER_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === DATA STACK v2 — AXIOM-STYLE TRENDING + FULL DATA ===
# DEX Screener stays always-on. Birdeye enriches promising candidates under a local CU budget.
DEX_DISCOVERY_INTERVAL_MS=15000
DEX_CACHE_MS=8000
DEX_TIMEOUT_MS=6000
BIRDEYE_MIN_INTERVAL_MS=1100
BIRDEYE_CU_BUDGET_PER_HOUR=1800
BIRDEYE_SNAPSHOT_CACHE_MS=90000
BIRDEYE_DEEP_CANDIDATES=4
BIRDEYE_DEEP_MIN_SCORE=45
BIRDEYE_HOLDER_CANDIDATES=2
BIRDEYE_HOLDER_MIN_SCORE=68
BIRDEYE_HOLDER_CACHE_MS=300000
BIRDEYE_NEW_INTERVAL_MS=180000
BIRDEYE_TRENDING_INTERVAL_MS=300000
BIRDEYE_MEME_INTERVAL_MS=0
BIRDEYE_CU_COOLDOWN_MS=21600000
ROUTE_DEEP_CANDIDATES=4
BUNDLE_DEEP_CANDIDATES=3

# === WALLET ===
# NEVER commit your real private key.
BS58_PRIVATE_KEY=

# === MODE ===
LIVE_TRADING=false

# === SCANNER ===
DISCOVERY_INTERVAL_MS=15000
OBSERVATION_TICK_MS=10000
MIN_OBSERVATION_MS=30000
MAX_OBSERVATION_MS=90000
MAX_ACTIVE_CANDIDATES=20
PROMOTE_SCORE=55
BUY_SCORE=78
MIN_DATA_CONFIDENCE=70

# === SIZING ===
MIN_POSITION_USD=2
SOL_FEE_RESERVE=0.015
# SOL/USD: Jupiter primary, DEX Screener fallback, recent cache last resort.
SOL_USD_CACHE_MS=60000
SOL_USD_STALE_MS=300000

# === EXIT ===
# v2.1 exits use the FULL-POSITION Jupiter sell quote as the real P/L.
TAKE_PROFIT_PCT=30
STOP_LOSS_PCT=15
TRAILING_STOP_PCT=8
PROFIT_PROTECT_ARM_PCT=15
# Emergency exit if executable value drops >=20% between position polls.
EXECUTABLE_QUOTE_DROP_PCT=20
# Emergency exit if Jupiter exit value is <65% of the DEX/chart-implied value.
MIN_EXECUTABLE_VALUE_RATIO=0.65
# Label exits at/under this loss as rug/liquidity-collapse exits.
RUG_EXIT_PCT=45
MAX_POSITION_AGE_MIN=12
POSITION_POLL_MS=5000

# === OPTIONAL PRIORITY FEEDS ===
AXIOM_TRENDING_URL=
AXIOM_TRENDING_API_KEY=
FOMO_TRENDING_URL=
FOMO_TRENDING_API_KEY=

# === OPTIONAL BUNDLE SERVICE ===
BUNDLE_API_URL=
BUNDLE_API_KEY=

REQUIRE_SELL_ROUTE=true

POSITION_STATUS_INTERVAL_MS=5000
IDLE_POSITION_STATUS_INTERVAL_MS=30000

# Free phone push alerts (ntfy)
# Install the ntfy app and subscribe to this exact topic.
# Use a long random topic name so others cannot easily guess it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional: only needed if you use an authenticated/self-hosted ntfy server.
NTFY_TOKEN=
NTFY_TIMEOUT_MS=5000

MIN_ACTIVE_CANDIDATES=10
REWATCH_COOLDOWN_MS=60000
KNOWN_RETENTION_MS=900000
# SOL/USD background price cache
SOL_USD_REFRESH_MS=45000
SOL_USD_CACHE_MS=120000
SOL_USD_STALE_MS=300000
SOL_USD_TIMEOUT_MS=5000

# Jupiter request pacing / 429 protection
JUPITER_MIN_INTERVAL_MS=500
JUPITER_MAX_RETRIES=2

# === v2.2 SOCIAL / META RADAR ===
# Official X API v2 bearer token. Without it, bot still runs market + safety scoring.
X_BEARER_TOKEN=
SOCIAL_POLL_MS=60000
SOCIAL_TIMEOUT_MS=8000
SOCIAL_LOOKBACK_MIN=60
SOCIAL_MIN_BUY_SCORE=35
SOCIAL_REQUIRE_WHEN_ENABLED=true
META_RUNNER_SOCIAL_SCORE=60
META_TOP_TERMS=8
# Watchlist built in: Ansem, sling, Cobie, CZ, PoorGoat, Pump.fun

# === v2.2 SMART MONEY ===
# Uses Birdeye Top Traders wallet tags (smart_trader/sniper/insider/bundler/dev) for finalists.
SMART_MONEY_CANDIDATES=2
SMART_MONEY_MIN_SCORE=65

# === v2.2 ADAPTIVE LOSS CONTROL ===
SOFT_STOP_LOSS_PCT=8
HARD_STOP_LOSS_PCT=12
STRONG_MOMENTUM_BUY_SELL_RATIO=1.5
STRONG_MOMENTUM_MIN_PRICE_5M_PCT=-3
