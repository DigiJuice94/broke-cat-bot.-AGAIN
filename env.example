# === REQUIRED DATA ===
BIRDEYE_API_KEY=
JUPITER_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Helius deep-data controls (defaults are safe for a small candidate pool)
HELIUS_TIMEOUT_MS=8000
HELIUS_HOLDER_CACHE_MS=30000
HELIUS_ACTIVITY_LIMIT=100
HELIUS_UNIQUE_WALLET_MIN_TX=8

# === WALLET ===
# Trust Wallet / Solana private key. NEVER commit this value.
# Supports a base58 Solana secret key OR a JSON byte array like [1,2,...].
BS58_PRIVATE_KEY=

# === MODE ===
# Keep false until logs/scoring look right. Set true for actual swaps.
LIVE_TRADING=false

# === SCANNER PHILOSOPHY ===
DISCOVERY_INTERVAL_MS=12000
OBSERVATION_TICK_MS=10000
MIN_OBSERVATION_MS=30000
MAX_OBSERVATION_MS=90000
MAX_ACTIVE_CANDIDATES=20
PROMOTE_SCORE=55
BUY_SCORE=78
MIN_DATA_CONFIDENCE=70

# === WALLET / SIZING ===
MIN_POSITION_USD=2
SOL_FEE_RESERVE=0.015
# No maximum position cap. The sizing engine chooses from spendable balance.

# === EXIT ===
TAKE_PROFIT_PCT=45
STOP_LOSS_PCT=18
TRAILING_STOP_PCT=12
MAX_POSITION_AGE_MIN=12
POSITION_POLL_MS=5000

# === OPTIONAL PRIORITY FEEDS ===
# JSON endpoints you control/proxy. Expected: [{address,name,symbol,rank}] or {tokens:[...]}
AXIOM_TRENDING_URL=
AXIOM_TRENDING_API_KEY=
FOMO_TRENDING_URL=
FOMO_TRENDING_API_KEY=

# === OPTIONAL BUNDLE SERVICE ===
# Expected JSON can contain riskScore/bundlePercent/bundledPercent/status.
BUNDLE_API_URL=
BUNDLE_API_KEY=

# === SAFETY / EXECUTION ===
# Quote both directions before buying. Missing bundle data lowers confidence, not auto-reject.
REQUIRE_SELL_ROUTE=true
